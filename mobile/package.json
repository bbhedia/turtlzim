{
  "name": "zim-notebook-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Zim notebook web app (../web) in a Capacitor shell for Android. See ../docs/zim-mobile-shell.md.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prepare:web": "node scripts/prepare.mjs",
    "sync": "node scripts/prepare.mjs && cap sync android",
