    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.1",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
