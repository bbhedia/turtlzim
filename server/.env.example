# The settings of the account server (server/, docs/zim-server.md, docs/zim-delivery.md). NOTHING here is a secret: the values are examples, and where a secret goes, it is left empty.
#
# The server does not read a `.env` file: these are ENVIRONMENT variables. Where they are set depends on where it runs:
#   - with scripts/run.sh (dev):   in the shell, e.g. `ZIM_BASE_URL=https://localhost:8144 scripts/run.sh start ...`
#   - on the staging machine:      /etc/turtlzim/env, which the units read (made by scripts/deploy/provision-turtlzim.sh; it is yours to edit)
#   - in production:               the hoster's own variables (not chosen yet)
# The environment wins over `config.json` and `oauth.json` in the data folder; the secrets of the sign-in apps can be in `oauth.json` (mode 600) instead, which the backups hold.
# The lines are `NAME=value` with the value in double quotes if it has spaces: that is also what a systemd EnvironmentFile reads.

# ---- where people reach it, and where it keeps what it keeps ------------------------------------------------------------------------------------------------
# The address that people TYPE. The sign-in services send the browser back to it, and it decides whether cookies are `Secure` (https). A server started without it takes http://localhost:8080 and says so.
ZIM_BASE_URL=https://example.org:8244
# The data folder: the SQLite database, the key that its codes and sealed settings are made with, the backups. Default: ~/.local/state/zim-server. Mode 700.
ZIM_SERVER_DATA=/var/lib/turtlzim
# Where the self-signed certificate is made (`$XDG_STATE_HOME/zim-web/tls`; default ~/.local/state). It is made again when the names it is for change (--name) or after about 300 days.
#XDG_STATE_HOME=
# Only behind a proxy that sets X-Forwarded-For (a hoster's). Anywhere else leave it unset: a client could write that header itself.
#ZIM_TRUST_PROXY=1

# ---- the cost of a password ---------------------------------------------------------------------------------------------------------------------------------
# How many passwords are hashed at once (default: half the processors, at least one; about 32 MiB each) and how many may wait for their turn (default 64; beyond that, 503 with Retry-After).
#ZIM_HASH_SLOTS=1
#ZIM_HASH_QUEUE=64

# ---- the e-mailed code at sign-up ---------------------------------------------------------------------------------------------------------------------------
# Without ZIM_SMTP_HOST the codes are written to a file in the data folder (outbox.jsonl): enough to try the server.
#ZIM_SMTP_HOST=smtp.example.org
#ZIM_SMTP_PORT=587
#ZIM_SMTP_SECURE=0
#ZIM_SMTP_USER=
#ZIM_SMTP_PASS=
#ZIM_MAIL_FROM="Zim Notebook <no-reply@example.org>"

# ---- the apps that people sign in with, and the services that notebooks can be kept on -----------------------------------------------------------------------
# One app per environment (an app has one return address). How to make them: docs/zim-server.md. Leave the secrets empty here; put them in the environment of the machine, or in oauth.json.
#ZIM_GOOGLE_CLIENT_ID=
#ZIM_GOOGLE_CLIENT_SECRET=
#ZIM_GITHUB_CLIENT_ID=
#ZIM_GITHUB_CLIENT_SECRET=
#ZIM_DROPBOX_CLIENT_ID=
#ZIM_DROPBOX_CLIENT_SECRET=
#ZIM_GDRIVE_CLIENT_ID=
#ZIM_GDRIVE_CLIENT_SECRET=

# ---- scripts/run.sh (a server that a person starts) ---------------------------------------------------------------------------------------------------------
# When the log is moved aside at a start (default 5242880 bytes), and what `run.sh ensure` runs to tell you that it restarted the server (docs/zim-operations.md).
#ZIM_LOG_MAX_BYTES=5242880
#ZIM_ALERT_COMMAND=

# ---- the staging machine (scripts/deploy/turtlzim-update.mjs and the units; docs/zim-delivery.md) -----------------------------------------------------------
# The server's own arguments: the https port, the names that the certificate is made for, the http port that only redirects, and the pid file that makes `backup.mjs restore` refuse while it runs.
#TURTLZIM_ARGS="--host :: --port 8244 --tls --name 192.0.2.11 --name example.org --redirect-port 8281 --pid-file /var/lib/turtlzim/serve.pid --dir ../web/dist"
# The release that the machine follows (the pre-release `beta` of this repository), and where it keeps what it unpacks.
#TURTLZIM_REPO=bbhedia/turtlzim
#TURTLZIM_CHANNEL=beta
#TURTLZIM_ROOT=/opt/turtlzim
#TURTLZIM_ETC=/etc/turtlzim
# Not for a machine: where a release is looked for (a test's stand-in for GitHub), the unit and the way to reach systemd, how many versions are kept, how long and how often the server is waited for.
#TURTLZIM_RELEASE_URL=
#TURTLZIM_UNIT=turtlzim.service
#TURTLZIM_SYSTEMCTL="systemctl --user"
#TURTLZIM_KEEP=3
#TURTLZIM_HEALTH_SECONDS=90
#TURTLZIM_POLL_MS=1000
